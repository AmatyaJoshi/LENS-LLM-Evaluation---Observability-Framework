# Copy to .env for local development. All variables are optional.
LENS_ENV=dev
LENS_API_KEY=

# Storage. Without Docker (no ClickHouse/Postgres) use the no-Docker combo:
#   span store in memory, relational store in a local SQLite file.
LENS_SPAN_STORE=memory                 # clickhouse | memory
LENS_POSTGRES_DSN=sqlite:///./lens.db  # or postgresql+psycopg://lens:lens@localhost:5432/lens
LENS_CLICKHOUSE_HOST=localhost
LENS_CLICKHOUSE_PORT=8123
LENS_CLICKHOUSE_USER=lens
LENS_CLICKHOUSE_PASSWORD=lens
LENS_CLICKHOUSE_DATABASE=lens
LENS_REDIS_URL=redis://localhost:6379/0
LENS_REDACT_APPS=
LENS_MAX_ATTRIBUTE_BYTES=65536

# Online evaluation sampling (needs an LLM key below): off | inline | celery
LENS_EVAL_DISPATCH=off
LENS_EVAL_SAMPLE_RATE=0.1

# --- LLM for judges + the AI Assistant ------------------------------------------------------
# Easiest: one OpenRouter key fronts Claude, GPT and others. Get one at openrouter.ai/keys.
OPENROUTER_API_KEY=
# Optional overrides (defaults use OpenRouter automatically when the key above is set):
# LENS_JUDGE_FRONTIER_MODEL=openrouter/anthropic/claude-3.5-sonnet
# LENS_JUDGE_SECOND_OPINION_MODEL=openrouter/openai/gpt-4o-mini
# Or use provider keys directly instead of OpenRouter:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

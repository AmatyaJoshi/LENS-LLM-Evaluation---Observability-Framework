# Copy to .env for local development. All variables are optional.
LENS_ENV=dev
LENS_API_KEY=
LENS_SPAN_STORE=clickhouse           # clickhouse | memory
LENS_CLICKHOUSE_HOST=localhost
LENS_CLICKHOUSE_PORT=8123
LENS_CLICKHOUSE_USER=lens
LENS_CLICKHOUSE_PASSWORD=lens
LENS_CLICKHOUSE_DATABASE=lens
LENS_POSTGRES_DSN=postgresql+psycopg://lens:lens@localhost:5432/lens
LENS_REDIS_URL=redis://localhost:6379/0
LENS_REDACT_APPS=                    # e.g. "rag_demo,sentinel" or "*"
LENS_MAX_ATTRIBUTE_BYTES=65536

# Judges (phase 3+)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LENS_WEB_PORT=3000                   # host port for the dashboard
